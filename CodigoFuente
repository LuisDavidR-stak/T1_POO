package cafeteria_universitaria;


public class clase_Cliente {
    private String cod_cliente,nombre_cliente,correo_cliente;
    public clase_Cliente(String cod_cliente, String nombre_cliente, String correo_cliente) {
        this.cod_cliente = cod_cliente;
        this.nombre_cliente = nombre_cliente;
        this.correo_cliente = correo_cliente;
    }

    public void setCod_cliente(String cod_cliente) {
        this.cod_cliente = cod_cliente;
    }

    public void setNombre_cliente(String nombre_cliente) {
        this.nombre_cliente = nombre_cliente;
    }

    public void setCorreo_cliente(String correo_cliente) {
        this.correo_cliente = correo_cliente;
    }

    public String getCod_cliente() {
        return cod_cliente;
    }

    public String getNombre_cliente() {
        return nombre_cliente;
    }

    public String getCorreo_cliente() {
        return correo_cliente;
    }
    public void MostrarDatos()
    {
        System.out.println("Codigo "+ this.cod_cliente+ "Nombre "+ this.nombre_cliente + " Email "+ this.correo_cliente);
    }
}


package cafeteria_universitaria;

import java.util.HashMap;

public class pedido {
    private String codigo_pedido,descripcion,estado_pedido;
    private double Precio;
    private int cantidad;
    private HashMap<String,Cliente> pedido;
public pedido()
{
this.pedido = new HashMap<String,Cliente>();
}
    public pedido(String codigo_pedido, String descripcion, double Precio, int cantidad) {
        this.codigo_pedido = codigo_pedido;
        this.descripcion = descripcion;
        this.Precio = Precio;
        this.cantidad = cantidad;
        this.pedido = new HashMap<String,Cliente>();
    }

    public String getCodigo_pedido() {
        return codigo_pedido;
    }

    public String getDescripcion() {
        return descripcion;
    }

    public String getEstado_pedido() {
        return estado_pedido;
    }

    public double getPrecio() {
        return Precio;
    }

    public int getCantidad() {
        return cantidad;
    }

    public void setCodigo_pedido(String codigo_pedido) {
        this.codigo_pedido = codigo_pedido;
    }

    public void setDescripcion(String descripcion) {
        this.descripcion = descripcion;
    }

    public void setEstado_pedido(String estado_pedido) {
        this.estado_pedido = estado_pedido;
    }

    public void setPrecio(double Precio) {
        this.Precio = Precio;
    }

    public void setCantidad(int cantidad) {
        this.cantidad = cantidad;
    }
    public HashMap<String,Cliente> getPedidos()
    {
        return pedido;
    }
    public void AgregarCliente(Cliente obj_cliente)
    {
        if(pedido.containsKey(obj_cliente.getCod_cliente()))
        {
            System.out.println("YA ESTA REGISTRADO");
        }
        else
        {
            pedido.put(obj_cliente.getCod_cliente(),obj_cliente);
            System.out.println("Cliente registrado");
        }
    }
    public Cliente Buscarparticipante(String id)
    {
    return pedido.get(id);
    }
}

